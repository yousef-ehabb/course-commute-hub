{
  "rules": {
    "rakeb": {
      "users": {
        ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin')",
          ".write": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'student' && ((!root.child('rakeb/courses/' + newData.child('courseId').val()).exists() && newData.child('courseId').val() === 'default') || root.child('rakeb/courses/' + newData.child('courseId').val() + '/status').val() === 'active') && (!root.child('rakeb/courses/' + newData.child('courseId').val() + '/registrationDeadline').exists() || now <= root.child('rakeb/courses/' + newData.child('courseId').val() + '/registrationDeadline').val())) || (data.exists() && data.child('role').val() === newData.child('role').val() && data.child('courseId').val() === newData.child('courseId').val()))))",
          "paymentStatus": {
            ".validate": "root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (!data.exists() && (newData.val() === 'pending_payment' || (newData.val() === 'active' && root.child('rakeb/courses/' + newData.parent().child('courseId').val() + '/transportation/payment/isFree').val() === true))) || (newData.val() === 'payment_submitted' && (data.val() === 'pending_payment' || data.val() === 'payment_rejected'))"
          }
        }
      },
      "usersByNationalId": {
        ".read": "auth != null",
        "$nid": {
          ".write": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)))"
        }
      },
      "usersByPhone": {
        ".read": "auth != null",
        "$phone": {
          ".write": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)))"
        }
      },
      "payments": {
        ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
        "$courseId": {
          ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin')",
            ".write": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (auth.uid === $uid && newData.child('status').val() === 'submitted' && !newData.child('verifiedBy').exists() && !newData.child('verifiedAt').exists()))"
          }
        }
      },
      "stations": {
        ".read": true,
        ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "courses": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "archivedUsers": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
        "$courseId": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin')"
          }
        }
      },
      "archivedUsersIndex": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin')",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "deletedUsers": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "settings": {
        "$courseId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "trips": {
        "$courseId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "tripHistory": {
        "$courseId": {
          ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "dailyStatus": {
        "$courseId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
          "$date": {
            "$uid": {
              ".write": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || (auth.uid === $uid && (root.child('rakeb/settings/' + $courseId + '/cutoffEnabled').val() !== true || !root.child('rakeb/settings/' + $courseId + '/cutoffTimestamp').exists() || now <= root.child('rakeb/settings/' + $courseId + '/cutoffTimestamp').val())))"
            }
          }
        }
      },
      "auditLog": {
        "$courseId": {
          ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
          ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "vehicles": {
        ".read": "auth != null",
        "$dateKey": {
          "$vehicleId": {
            ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' && (newData.exists() || data.child('status').val() === 'planned')",
            "capacity": {
              ".validate": "!data.parent().exists() || data.parent().child('status').val() === 'planned' || newData.val() === data.val()"
            },
            "currentLocation": {
              ".validate": "newData.parent().child('assignedCoordinatorId').val() === auth.uid"
            },
            "occupiedSeats": {
              ".validate": "newData.val() <= newData.parent().child('capacity').val() && newData.val() >= 0"
            },
            "assignedCoordinatorId": {
              ".validate": "newData.val() === null || root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
            }
          }
        }
      },
      "boardingRecords": {
        "$dateKey": {
          ".read": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'",
          "$studentId": {
            ".read": "auth != null && (root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin' || $studentId === auth.uid)",
            ".write": "auth != null && root.child('rakeb/users/' + auth.uid + '/role').val() === 'admin'"
          }
        }
      }
    }
  }
}